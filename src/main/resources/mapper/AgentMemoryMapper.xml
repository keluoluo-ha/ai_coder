<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhk.aicoder.mapper.AgentMemoryMapper">

    <resultMap id="BaseResultMap" type="com.hhk.aicoder.model.entity.AgentMemory">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="tag" property="tag"/>
        <result column="is_active" property="isActive"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_memory (user_id, content, tag, is_active)
        VALUES (#{userId}, #{content}, #{tag}, #{isActive})
    </insert>

    <update id="updateIsActiveById">
        UPDATE agent_memory
        SET is_active = #{isActive}
        WHERE id = #{id}
    </update>

    <select id="selectActiveByUserId" resultMap="BaseResultMap">
        SELECT id, user_id, content, tag, is_active, create_time, update_time
        FROM agent_memory
        WHERE user_id = #{userId}
          AND is_active = 1
        ORDER BY update_time DESC
        LIMIT 20
    </select>

</mapper>
